# Use backend/.env for local configuration. Never commit real values.
DB_NAME=school
DB_USER=school
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432
# Generate a private key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-new-private-random-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
