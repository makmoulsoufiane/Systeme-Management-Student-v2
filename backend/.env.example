# Placeholders only. Do not overwrite an existing .env with this file.
# Local development: use these DB_* fields and omit DATABASE_URL.
DB_NAME=REPLACE_WITH_LOCAL_DATABASE_NAME
DB_USER=REPLACE_WITH_LOCAL_DATABASE_ROLE
DB_PASSWORD=REPLACE_WITH_NEW_DATABASE_PASSWORD
DB_HOST=REPLACE_WITH_LOCAL_DATABASE_HOST
DB_PORT=REPLACE_WITH_LOCAL_DATABASE_PORT

# Render: use the following settings instead of the local DB_* fields.
DJANGO_ENV=REPLACE_WITH_staging
DJANGO_DEBUG=REPLACE_WITH_False
SECRET_KEY=REPLACE_WITH_NEW_RANDOM_KEY_OF_AT_LEAST_64_CHARACTERS
DATABASE_URL=REPLACE_WITH_NEW_RENDER_DATABASE_INTERNAL_URL
DB_SSL_REQUIRE=REPLACE_WITH_False_FOR_INTERNAL_OR_True_FOR_EXTERNAL_TLS
ALLOWED_HOSTS=REPLACE_WITH_BACKEND_HOSTNAME_WITHOUT_SCHEME
CORS_ALLOWED_ORIGINS=REPLACE_WITH_EXACT_FRONTEND_HTTPS_ORIGIN
